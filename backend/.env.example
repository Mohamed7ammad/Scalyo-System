# ─────────────────────────────────────────────────────────────────────────────
#  backend/.env.example
#  Copy this file to .env and fill in every value before starting the server.
#  NEVER commit the real .env file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# URL of the running Next.js frontend (used for CORS allow-list).
# In production change to your actual domain, e.g. https://app.example.com
FRONTEND_URL=http://localhost:3000

# ── Authentication ────────────────────────────────────────────────────────────
# Long random string used to sign and verify JSON Web Tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
# Full connection string — find it in Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase project URL and anonymous key — used if any Supabase client calls are needed.
# Find both in Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ── Webhooks ─────────────────────────────────────────────────────────────────
# Secret used to verify incoming webhooks (Google Sheets sync, generic webhooks).
WEBHOOK_SECRET=replace_with_webhook_secret

# ── Bosta Shipping Integration ────────────────────────────────────────────────
# Credentials for the Bosta shipping API.
# Obtain them from your Bosta merchant dashboard → API settings.
BOSTA_API_KEY=
BOSTA_BEARER_TOKEN=
BOSTA_EMAIL=
BOSTA_PASSWORD=
BOSTA_WEBHOOK_SECRET=

# ── Debug flags (optional) ────────────────────────────────────────────────────
# Set to 'false' once you have confirmed the field mappings are correct
# and you no longer need the one-shot JSON dumps in the server log.
TAAGER_DEBUG=true
SAFQA_DEBUG=true
